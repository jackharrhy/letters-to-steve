{
  "name": "letters-to-steve",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development node --env-file-if-exists=.env --watch --import remix/node-tsx server.ts",
    "hmr": "NODE_ENV=development node --env-file-if-exists=.env hmr.ts",
    "start": "NODE_ENV=production node --env-file-if-exists=.env --import remix/node-tsx server.ts",
    "test": "NODE_ENV=test node --import remix/node-tsx --test",
    "db:migrate": "remix db migrate",
    "db:status": "remix db status",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "dependencies": {
    "remix": "^3.0.0-rc.1"
  },
  "devDependencies": {
    "@types/node": "latest",
    "typescript": "latest"
  },
  "allowScripts": {
    "esbuild@0.27.2": true
  }
}
